# Copy this file to .env.nas on the NAS. Never commit the real file.
PORT=8080
DATA_DIR=/data
PUBLIC_DIR=/app/dist

# MariaDB 10 on Synology. Use host.docker.internal with compose.synology.yaml.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=workhub
DB_USER=workhub_app
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DB_CONNECTION_LIMIT=10

# Generate with: npm run hash:password
WORKHUB_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_SALT$REPLACE_HASH

# AI is used only for bill extraction.
GEMINI_API_KEY=REPLACE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional internal URL. Leave blank to hide phpMyAdmin from the app.
DATABASE_ADMIN_URL=
TRUST_PROXY=true
LOG_LEVEL=info

